APP_NAME=Employee Delegation System
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace_with_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# MySQL Database configuration
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD_HERE@localhost:3306/employee_delegation_db
